cc_library_static {
    name: "libwifi-hal-ath10k",
    proprietary: true,
    apex_available: [
        "//apex_available:platform",
        "com.android.hardware.wifi",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    srcs: [
        "halstate.cpp",
        "info.cpp",
        "interface.cpp",
        "netlink.cpp",
        "netlinkmessage.cpp",
        "wifi_hal.cpp",
    ],
    header_libs: [
        "wifi_legacy_headers",
    ],
    shared_libs: [
        "libnl",
        "liblog",
        "libcutils",
    ],
}
