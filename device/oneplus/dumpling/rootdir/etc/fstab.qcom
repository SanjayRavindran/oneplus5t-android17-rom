# <src> <mnt> <type> <mnt_flags> <fs_mgr_flags>
/dev/block/platform/soc@0/1da4000.ufshc/by-name/system    /system              erofs ro                                                       wait,first_stage_mount
/dev/block/platform/soc@0/1da4000.ufshc/by-name/vendor    /vendor              erofs ro                                                       wait,first_stage_mount
# dumpling has no /metadata partition: reuse the 256M cache partition for it
/dev/block/platform/soc@0/1da4000.ufshc/by-name/cache     /metadata            ext4  noatime,nosuid,nodev,discard                             wait,check,formattable,first_stage_mount
/dev/block/platform/soc@0/1da4000.ufshc/by-name/userdata  /data                f2fs  noatime,nosuid,nodev,discard                             latemount,wait,check,formattable,quota,reservedsize=128M
/dev/block/platform/soc@0/1da4000.ufshc/by-name/misc      /misc                emmc  defaults                                                 defaults
/dev/block/platform/soc@0/1da4000.ufshc/by-name/boot      /boot                emmc  defaults                                                 recoveryonly
/dev/block/platform/soc@0/1da4000.ufshc/by-name/recovery  /recovery            emmc  defaults                                                 recoveryonly
/dev/block/platform/soc@0/1da4000.ufshc/by-name/persist   /mnt/vendor/persist  ext4  noatime,nosuid,nodev                                     wait
/dev/block/platform/soc@0/1da4000.ufshc/by-name/modem     /vendor/firmware_mnt vfat  ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 wait
/dev/block/platform/soc@0/1da4000.ufshc/by-name/dsp       /vendor/dsp          ext4  ro,nosuid,nodev                                          wait
/dev/block/platform/soc@0/1da4000.ufshc/by-name/bluetooth /vendor/bt_firmware  vfat  ro,shortname=lower,uid=1002,gid=3002,dmask=222,fmask=333 wait
